{
  "name": "@workspace/api-server",
  "version": "0.1.0",
  "description": "AutoProfit identity, tenancy, catalog, and operational API",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run migrate && export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "pnpm run migrate && node --enable-source-maps ./dist/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts",
    "migrate:check": "tsx --eval=\"import('./src/config.ts').then(({loadConfig}) => { loadConfig(); console.log('configuration_ok') })\""
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^11.2.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.11.3",
    "pg": "^8.23.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "@types/node": "catalog:",
    "esbuild": "0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino": "^9.14.0",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "^4.23.12"
  }
}
