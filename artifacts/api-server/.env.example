NODE_ENV=development
PORT=5000
DATABASE_URL=postgres://user:password@localhost:5432/autoprofit
DB_POOL_MAX=6
SESSION_SECRET=replace-with-a-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
PASSWORD_RESET_TTL_MINUTES=30
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_AUTH=20
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
TOS_VERSION=2026-08-11
PRIVACY_VERSION=2026-08-11
OPTIONAL_PROCESSING_VERSION=2026-08-11
CORS_ORIGINS=
LOG_LEVEL=info